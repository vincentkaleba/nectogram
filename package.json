{
  "name": "nectogram",
  "version": "0.1.0",
  "description": "High-performance low-level MTProto Telegram client library for Node.js inspired by Kurigram/Pyrogram",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "bot": "tsx examples/bot.ts",
    "typecheck": "tsc --noEmit",
    "generate": "tsx compiler/tl-compiler.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "telegram",
    "mtproto",
    "pyrogram",
    "kurigram",
    "bot",
    "client",
    "node",
    "raw"
  ],
  "author": "",
  "license": "LGPL-3.0-or-later",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3"
  }
}
